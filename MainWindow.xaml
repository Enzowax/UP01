<Window x:Class="ShutIKrol.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E">

    <Window.Resources>
        <Style TargetType="Button" x:Key="SideBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10"
                                Width="48" Height="48">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#181825" BorderBrush="#313244" BorderThickness="0,0,1,0">
            <DockPanel VerticalAlignment="Stretch">
                <StackPanel DockPanel.Dock="Top">
                    <!-- App Logo -->
                    <TextBlock Text="📖" FontSize="28" HorizontalAlignment="Center"
                               Margin="0,16,0,16" Foreground="#CDD6F4"/>
                    <Separator Background="#313244" Margin="8,0"/>

                    <!-- Catalog -->
                    <Button x:Name="BtnCatalog" Style="{StaticResource SideBtn}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" Click="BtnCatalog_Click">
                        <Button.ToolTip><ToolTip Content="Каталог книг" ToolTipService.InitialShowDelay="800"/></Button.ToolTip>
                        <TextBlock Text="🏠"/>
                    </Button>

                    <!-- Reading Lists -->
                    <Button x:Name="BtnLists" Style="{StaticResource SideBtn}"
                            HorizontalAlignment="Center" Margin="0,4,0,0" Click="BtnLists_Click">
                        <Button.ToolTip><ToolTip Content="Списки книг" ToolTipService.InitialShowDelay="800"/></Button.ToolTip>
                        <TextBlock Text="📋"/>
                    </Button>

                    <!-- Author Page -->
                    <Button x:Name="BtnAuthor" Style="{StaticResource SideBtn}"
                            HorizontalAlignment="Center" Margin="0,4,0,0" Click="BtnAuthor_Click"
                            Visibility="Collapsed">
                        <Button.ToolTip><ToolTip Content="Страница автора" ToolTipService.InitialShowDelay="800"/></Button.ToolTip>
                        <TextBlock Text="✍️"/>
                    </Button>

                    <!-- Admin -->
                    <Button x:Name="BtnAdmin" Style="{StaticResource SideBtn}"
                            HorizontalAlignment="Center" Margin="0,4,0,0" Click="BtnAdmin_Click"
                            Visibility="Collapsed">
                        <Button.ToolTip><ToolTip Content="Администрирование" ToolTipService.InitialShowDelay="800"/></Button.ToolTip>
                        <TextBlock Text="🛡️"/>
                    </Button>

                    <!-- Freeze Warning -->
                    <Button x:Name="BtnFrozen" Style="{StaticResource SideBtn}"
                            HorizontalAlignment="Center" Margin="0,4,0,0" Click="BtnProfile_Click"
                            Visibility="Collapsed">
                        <Button.ToolTip><ToolTip Content="Аккаунт заморожен! Нажмите для просмотра" ToolTipService.InitialShowDelay="800"/></Button.ToolTip>
                        <TextBlock Text="❄️" Foreground="#89DCEB"/>
                    </Button>
                </StackPanel>

                <!-- Profile pinned to bottom -->
                <Button x:Name="BtnProfile" Style="{StaticResource SideBtn}"
                        DockPanel.Dock="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,16" Click="BtnProfile_Click">
                    <Button.ToolTip><ToolTip Content="Профиль" ToolTipService.InitialShowDelay="800"/></Button.ToolTip>
                    <TextBlock Text="👤"/>
                </Button>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- Content Frame -->
        <Frame x:Name="MainFrame" Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="#1E1E2E"/>
    </Grid>
</Window>
