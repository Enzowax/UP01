<Page x:Class="ShutIKrol.Pages.ReadingListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2E" Title="Списки книг">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page title -->
        <TextBlock Grid.Row="0" Text="Мои списки" Foreground="#CDD6F4"
                   FontSize="22" FontWeight="Bold" Margin="20,16,20,8"/>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#181825" Padding="16,10" BorderBrush="#313244" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" Padding="8,5" FontSize="13" Height="30"
                         Width="240" VerticalContentAlignment="Center"
                         TextChanged="Filter_Changed"/>
                <ComboBox x:Name="SortBox" Background="#313244" Foreground="#CDD6F4"
                          BorderBrush="#45475A" Height="30" Width="140" Margin="8,0,0,0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="По названию" IsSelected="True"/>
                    <ComboBoxItem Content="По оценке"/>
                </ComboBox>
                <ComboBox x:Name="GenreBox" Background="#313244" Foreground="#CDD6F4"
                          BorderBrush="#45475A" Height="30" Width="140" Margin="8,0,0,0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Все жанры" IsSelected="True" Tag="0"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0"
                    SelectionChanged="TabControl_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#A6ADC8"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Padding" Value="14,8"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="📌 В планах" x:Name="TabWant" Tag="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="PanelWant" Margin="12" Orientation="Horizontal"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="📖 Читаю" x:Name="TabReading" Tag="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="PanelReading" Margin="12" Orientation="Horizontal"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="✅ Прочитано" x:Name="TabFinished" Tag="7">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="PanelFinished" Margin="12" Orientation="Horizontal"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="🗑 Заброшено" x:Name="TabDropped" Tag="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="PanelDropped" Margin="12" Orientation="Horizontal"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
