<Page x:Class="ShutIKrol.Pages.AddEditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2E">

    <Page.Resources>
        <Style TargetType="TextBox" x:Key="Input">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="36"/>
        </Style>
        <Style TargetType="Label" x:Key="Lbl">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="600">
            <TextBlock x:Name="PageTitle" Text="Добавить книгу" Foreground="#CDD6F4"
                       FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

            <Label Content="Название книги" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource Input}"/>

            <Label Content="Путь к обложке (например: /covers/mybook.jpg)" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="CoverBox" Style="{StaticResource Input}"/>

            <Label Content="Жанры (выберите один или несколько)" Style="{StaticResource Lbl}"/>
            <ListBox x:Name="GenresList" Background="#313244" Foreground="#CDD6F4"
                     BorderBrush="#45475A" Height="120" SelectionMode="Multiple"
                     Margin="0,0,0,8"/>

            <!-- Chapters Section -->
            <Label Content="Главы" Style="{StaticResource Lbl}"/>
            <ItemsControl x:Name="ChaptersControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#313244" CornerRadius="6" Margin="0,0,0,6" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number, StringFormat='#{0}'}" Foreground="#A6ADC8" VerticalAlignment="Center" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#CDD6F4" VerticalAlignment="Center" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="{Binding Path}" Foreground="#585B70" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add Chapter -->
            <Expander Header="+ Добавить главу" Foreground="#89B4FA" Margin="0,4,0,12">
                <Border Background="#313244" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                    <StackPanel>
                        <Label Content="Название главы" Style="{StaticResource Lbl}" Margin="0,0,0,2"/>
                        <TextBox x:Name="ChNameBox" Style="{StaticResource Input}"/>
                        <Label Content="Путь к файлу (например: /chapters/1/ch1.txt)" Style="{StaticResource Lbl}" Margin="0,8,0,2"/>
                        <TextBox x:Name="ChPathBox" Style="{StaticResource Input}"/>
                        <Button x:Name="AddChapterBtn" Content="Добавить главу"
                                Background="#89B4FA" Foreground="#1E1E2E"
                                Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="AddChapterBtn_Click"/>
                    </StackPanel>
                </Border>
            </Expander>

            <!-- Error -->
            <TextBlock x:Name="ErrorText" Foreground="#F38BA8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveBtn" Content="💾 Сохранить"
                        Background="#A6E3A1" Foreground="#1E1E2E"
                        Style="{StaticResource Btn}" Click="SaveBtn_Click" Margin="0,0,12,0"/>
                <Button x:Name="CancelBtn" Content="Отмена"
                        Background="#45475A" Foreground="#CDD6F4"
                        Style="{StaticResource Btn}" Click="CancelBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
