<Window x:Class="ShutIKrol.Pages.ComplaintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1E1E2E" ResizeMode="NoResize"
        Height="240" Width="400" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleLabel" FontSize="16" FontWeight="Bold"
                   Foreground="#CDD6F4" Margin="0,0,0,12"/>
        <TextBlock Text="Причина:" Foreground="#A6ADC8" Margin="0,0,0,4"/>
        <TextBox x:Name="ReasonBox" Background="#313244" Foreground="#CDD6F4"
                 BorderBrush="#45475A" Padding="8,6" FontSize="13"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Click="Cancel_Click"
                    Background="#45475A" Foreground="#CDD6F4"
                    BorderThickness="0" Padding="14,6" Cursor="Hand" Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Отправить" Click="Send_Click"
                    Background="#F38BA8" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0" Padding="14,6" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
