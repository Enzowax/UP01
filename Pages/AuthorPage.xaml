<Page x:Class="ShutIKrol.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2E" Title="Страница автора">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#181825" Padding="20,14" BorderBrush="#313244" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="✍️ Мои книги" Foreground="#CDD6F4" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="AddBookBtn" Content="+ Добавить книгу"
                        Background="#A6E3A1" Foreground="#1E1E2E" FontWeight="Bold"
                        BorderThickness="0" Padding="14,8" Cursor="Hand"
                        HorizontalAlignment="Right" Click="AddBookBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#A6ADC8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="14,8"/>
                </Style>
            </TabControl.Resources>

            <!-- Published Books -->
            <TabItem Header="📚 Опубликованные">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="PublishedPanel" Margin="12" Orientation="Horizontal"/>
                </ScrollViewer>
            </TabItem>

            <!-- Frozen Books -->
            <TabItem Header="❄️ Замороженные">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="FrozenPanel" Margin="12" Orientation="Horizontal"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
