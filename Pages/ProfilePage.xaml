<Page x:Class="ShutIKrol.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2E" Title="Профиль">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="700">

            <!-- Freeze Banner -->
            <Border x:Name="FrozenBanner" Background="#F38BA8" CornerRadius="8" Padding="16"
                    Visibility="Collapsed" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="❄️ Ваш аккаунт заморожен" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock x:Name="FreezeReasonText" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button x:Name="AppealBtn" Content="📝 Оспорить заморозку" Click="AppealBtn_Click"
                            Background="White" Foreground="#F38BA8" FontWeight="Bold"
                            BorderThickness="0" Padding="14,7" Cursor="Hand" HorizontalAlignment="Left">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- User Info Card -->
            <Border Background="#313244" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="👤" FontSize="60" Margin="0,0,20,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="UserName" FontSize="22" FontWeight="Bold" Foreground="#CDD6F4"/>
                        <TextBlock x:Name="UserLogin" Foreground="#89B4FA" FontSize="14" Margin="0,4,0,2"/>
                        <TextBlock x:Name="UserEmail" Foreground="#A6ADC8" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock x:Name="UserRole" Foreground="#A6E3A1" FontSize="13" Margin="0,0,0,2"/>
                        <TextBlock x:Name="UserRegDate" Foreground="#585B70" FontSize="12"/>
                    </StackPanel>
                    <Button x:Name="RequestAuthorBtn" Grid.Column="2"
                            Content="✍️ Стать автором" Click="RequestAuthorBtn_Click"
                            Background="#CBA6F7" Foreground="#1E1E2E" FontWeight="Bold"
                            BorderThickness="0" Padding="14,8" Cursor="Hand" VerticalAlignment="Top"
                            Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Logout -->
            <Button x:Name="LogoutBtn" Content="🚪 Выйти из аккаунта" Click="LogoutBtn_Click"
                    Background="#45475A" Foreground="#CDD6F4" HorizontalAlignment="Left"
                    BorderThickness="0" Padding="14,8" Cursor="Hand" Margin="0,0,0,24">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Reviews Section -->
            <TextBlock Text="Мои отзывы" Foreground="#CDD6F4" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
            <ItemsControl x:Name="ReviewsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#313244" CornerRadius="8" Margin="0,0,0,8" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding BookId, StringFormat='Книга #{0}'}" Foreground="#89B4FA" FontWeight="Bold"/>
                                    <TextBlock Text=" — " Foreground="#585B70"/>
                                    <TextBlock Text="{Binding Rate, StringFormat='⭐ {0}/10'}" Foreground="#F9E2AF"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Text}" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,4,0,4" FontSize="13"/>
                                <TextBlock Text="{Binding CreationDate, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#585B70" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="NoReviews" Text="У вас пока нет отзывов." Foreground="#585B70"
                       FontSize="14" Visibility="Collapsed" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
