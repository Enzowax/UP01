<Window x:Class="ShutIKrol.Pages.ChapterReadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1E1E2E" Height="600" Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ChapterTitle" Grid.Row="0" FontSize="20" FontWeight="Bold"
                   Foreground="#CDD6F4" Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ChapterText" Foreground="#CDD6F4" FontSize="15" LineHeight="26"
                       TextWrapping="Wrap"/>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Закрыть" Click="Close_Click"
                Background="#45475A" Foreground="#CDD6F4"
                BorderThickness="0" Padding="20,8" Cursor="Hand"
                HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
