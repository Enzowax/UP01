<Page x:Class="ShutIKrol.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2E" Title="Книга">

    <Page.Resources>
        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="ReviewInput">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="60"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Back Button -->
            <Button x:Name="BackBtn" Content="← Назад в каталог" Click="BackBtn_Click"
                    Background="#45475A" Foreground="#CDD6F4"
                    Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <!-- Book Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cover -->
                <Border Grid.Column="0" x:Name="CoverBorder" Height="220" Width="150"
                        Background="#313244" CornerRadius="10" VerticalAlignment="Top">
                    <TextBlock x:Name="CoverPlaceholder" Text="📚" FontSize="60"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Info -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock x:Name="TitleText" Foreground="#CDD6F4" FontSize="24" FontWeight="Bold"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="AuthorText" Foreground="#89B4FA" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock x:Name="GenresText" Foreground="#A6ADC8" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RatingText" Foreground="#F9E2AF" FontSize="16" Margin="0,0,0,12"/>

                    <!-- Action Buttons -->
                    <WrapPanel x:Name="ActionPanel">
                        <Button x:Name="AddToListBtn" Content="📋 Добавить в список"
                                Background="#89B4FA" Foreground="#1E1E2E"
                                Style="{StaticResource Btn}" Margin="0,0,8,8"
                                Click="AddToListBtn_Click"/>
                        <Button x:Name="ComplainBookBtn" Content="⚠ Жалоба на книгу"
                                Background="#F38BA8" Foreground="#1E1E2E"
                                Style="{StaticResource Btn}" Margin="0,0,8,8"
                                Click="ComplainBookBtn_Click"/>
                        <Button x:Name="ComplainAuthorBtn" Content="⚠ Жалоба на автора"
                                Background="#FAB387" Foreground="#1E1E2E"
                                Style="{StaticResource Btn}" Margin="0,0,8,8"
                                Click="ComplainAuthorBtn_Click"/>
                        <Button x:Name="FreezeBookBtn" Content="❄ Заморозить книгу"
                                Background="#89DCEB" Foreground="#1E1E2E"
                                Style="{StaticResource Btn}" Margin="0,0,8,8"
                                Click="FreezeBookBtn_Click" Visibility="Collapsed"/>
                    </WrapPanel>

                    <Border x:Name="FrozenBanner" Background="#F38BA8" CornerRadius="6"
                            Padding="12,8" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="❄️ Книга заморожена администратором" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Chapters -->
            <TextBlock Text="Главы" Foreground="#CDD6F4" FontSize="18" FontWeight="Bold" Margin="0,8,0,8"/>
            <ItemsControl x:Name="ChaptersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#313244" CornerRadius="6" Margin="0,0,0,6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="#CDD6F4" FontSize="13" VerticalAlignment="Center">
                                    <Run Text="{Binding Number, StringFormat='Глава {0}: '}"/>
                                    <Run Text="{Binding Name}"/>
                                </TextBlock>
                                <Button Grid.Column="1" Content="Читать 📖" Tag="{Binding}"
                                        Background="#89B4FA" Foreground="#1E1E2E"
                                        BorderThickness="0" Padding="10,4" Cursor="Hand"
                                        Click="ReadChapter_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Reviews Header -->
            <Grid Margin="0,16,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Отзывы" Foreground="#CDD6F4" FontSize="18" FontWeight="Bold"/>
            </Grid>

            <!-- Add Review Form -->
            <Border x:Name="ReviewForm" Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Оставить отзыв" Foreground="#CDD6F4" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox x:Name="ReviewText" Style="{StaticResource ReviewInput}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Оценка (1-10):" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="RatingBox" Background="#45475A" Foreground="#CDD6F4" Width="70" Height="28"/>
                        <Button x:Name="SubmitReview" Content="Отправить" Margin="12,0,0,0"
                                Background="#A6E3A1" Foreground="#1E1E2E"
                                Style="{StaticResource Btn}" Click="SubmitReview_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Reviews List -->
            <ItemsControl x:Name="ReviewsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#313244" CornerRadius="8" Margin="0,0,0,8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding UserName}" Foreground="#89B4FA" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text=" — " Foreground="#585B70"/>
                                        <TextBlock Text="{Binding Rate, StringFormat='⭐ {0}/10'}" Foreground="#F9E2AF" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="⚠ Жалоба" Tag="{Binding Id}"
                                                Background="#F38BA8" Foreground="#1E1E2E"
                                                BorderThickness="0" Padding="8,3" Cursor="Hand" FontSize="11"
                                                Click="ComplainReview_Click" Margin="0,0,4,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="🗑 Удалить" Tag="{Binding Id}"
                                                Background="#585B70" Foreground="#CDD6F4"
                                                BorderThickness="0" Padding="8,3" Cursor="Hand" FontSize="11"
                                                Click="DeleteReview_Click" x:Name="DelReviewBtn">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Text}" Foreground="#CDD6F4" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13"/>
                                <TextBlock Grid.Row="2" Text="{Binding CreationDate, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#585B70" FontSize="11" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
