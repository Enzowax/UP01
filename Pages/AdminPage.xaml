<Page x:Class="ShutIKrol.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2E" Title="Администрирование">

    <Page.Resources>
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid" x:Key="Grid">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#45475A"/>
            <Setter Property="RowBackground" Value="#313244"/>
            <Setter Property="AlternatingRowBackground" Value="#2A2A3D"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🛡️ Администрирование" Foreground="#CDD6F4"
                   FontSize="22" FontWeight="Bold" Margin="20,16,20,8"/>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#A6ADC8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="12,8"/>
                </Style>
            </TabControl.Resources>

            <!-- Complaints Tab -->
            <TabItem Header="⚠ Жалобы" >
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ComplaintsGrid" Style="{StaticResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="От пользователя" Binding="{Binding UserName}" Width="140"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding TargetType}" Width="80"/>
                            <DataGridTextColumn Header="Книга" Binding="{Binding BookName}" Width="140"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding ReasonText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="✅ Принять (заморозить цель)" Background="#A6E3A1" Foreground="#1E1E2E"
                                Style="{StaticResource ActionBtn}" Click="AcceptComplaint_Click"/>
                        <Button Content="❌ Отклонить (удалить жалобу)" Background="#F38BA8" Foreground="#1E1E2E"
                                Style="{StaticResource ActionBtn}" Click="RejectComplaint_Click"/>
                        <Button Content="🔄 Обновить" Background="#45475A" Foreground="#CDD6F4"
                                Style="{StaticResource ActionBtn}" Click="RefreshComplaints_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Unfreeze Requests Tab -->
            <TabItem Header="❄ Заявки на разморозку" >
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="UnfreezeGrid" Style="{StaticResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="150"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="160"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="✅ Принять (разморозить)" Background="#A6E3A1" Foreground="#1E1E2E"
                                Style="{StaticResource ActionBtn}" Click="AcceptUnfreeze_Click"/>
                        <Button Content="❌ Отклонить" Background="#F38BA8" Foreground="#1E1E2E"
                                Style="{StaticResource ActionBtn}" Click="RejectUnfreeze_Click"/>
                        <Button Content="🔄 Обновить" Background="#45475A" Foreground="#CDD6F4"
                                Style="{StaticResource ActionBtn}" Click="RefreshUnfreeze_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Author Role Requests -->
            <TabItem Header="✍ Заявки авторов" >
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="AuthorReqGrid" Style="{StaticResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="180"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="✅ Принять (дать роль Автора)" Background="#A6E3A1" Foreground="#1E1E2E"
                                Style="{StaticResource ActionBtn}" Click="AcceptAuthorReq_Click"/>
                        <Button Content="❌ Отклонить" Background="#F38BA8" Foreground="#1E1E2E"
                                Style="{StaticResource ActionBtn}" Click="RejectAuthorReq_Click"/>
                        <Button Content="🔄 Обновить" Background="#45475A" Foreground="#CDD6F4"
                                Style="{StaticResource ActionBtn}" Click="RefreshAuthorReq_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Frozen Items Tab -->
            <TabItem Header="❄️ Замороженные" >
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="Книги">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="FrozenBooksGrid" Style="{StaticResource Grid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                                    <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Grid.Row="1" Content="🔓 Разморозить книгу" Background="#A6E3A1" Foreground="#1E1E2E"
                                    Style="{StaticResource ActionBtn}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Click="UnfreezeBook_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Пользователи">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="FrozenUsersGrid" Style="{StaticResource Grid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="160"/>
                                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120"/>
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Grid.Row="1" Content="🔓 Разморозить пользователя" Background="#A6E3A1" Foreground="#1E1E2E"
                                    Style="{StaticResource ActionBtn}" HorizontalAlignment="Left"
                                    Margin="0,8,0,0" Click="UnfreezeUser_Click"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- Users Tab -->
            <TabItem Header="👥 Пользователи" >
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="UsersGrid" Style="{StaticResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="90"/>
                            <DataGridTextColumn Header="Заморожен" Binding="{Binding IsFrozen}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="🔄 Обновить" Background="#45475A" Foreground="#CDD6F4"
                                Style="{StaticResource ActionBtn}" Click="RefreshUsers_Click"/>
                        <Button Content="📋 Назначить роль" Background="#89B4FA" Foreground="#1E1E2E"
                                Style="{StaticResource ActionBtn}" Click="SetRole_Click"/>
                        <Button Content="❄ Заморозить" Background="#89DCEB" Foreground="#1E1E2E"
                                Style="{StaticResource ActionBtn}" Click="FreezeUser_Click"/>
                        <Button Content="🔓 Разморозить" Background="#A6E3A1" Foreground="#1E1E2E"
                                Style="{StaticResource ActionBtn}" Click="UnfreezeUserInList_Click"/>
                        <Button Content="🔑 Сменить пароль" Background="#CBA6F7" Foreground="#1E1E2E"
                                Style="{StaticResource ActionBtn}" Click="ChangePassword_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
